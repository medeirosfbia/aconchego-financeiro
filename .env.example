# ==============================================================================
# Aconchego Finanças — Variáveis de Ambiente
# Copie este arquivo para `.env` (uso local) e nunca faça commit do `.env`.
# ==============================================================================

# URL do projeto Supabase (Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave pública (Publishable / Anon Key) do Supabase
# Nunca utilize a Service Role Key no navegador.
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_SUPABASE_PUBLISHABLE_KEY"

# Chave privada da API Gemini (usada exclusivamente no backend / Vercel Functions)
GEMINI_API_KEY="SUA_GEMINI_API_KEY"

# Modelo Gemini oficial utilizado pelo scanner de comprovantes e pelo agente financeiro
GEMINI_MODEL="gemini-2.5-flash"

# URL pública da aplicação (ex: http://localhost:3000 localmente ou URL da Vercel)
APP_URL="http://localhost:3000"

# Opcional: liberar consumo da Gemini API sem login no modo demo (padrão: desativado).
ENABLE_DEMO_AI="false"

# Contas sintéticas confirmadas para E2E real; nunca usar contas pessoais.
E2E_USER_A_EMAIL=""
E2E_USER_A_PASSWORD=""
E2E_USER_B_EMAIL=""
E2E_USER_B_PASSWORD=""
